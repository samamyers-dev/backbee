<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose supplies the real theme. This exists so the window has sensible
      colours before the first frame and does not flash white on a dark device.
    -->
    <style name="Theme.Backbee" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
