<?xml version="1.0" encoding="utf-8"?>
<!--
  As in backup_rules.xml: listing a path in a domain excludes everything else
  in that domain, so files/episodes/ (the downloaded audio) is left out by not
  being named rather than by an <exclude>, which lint rejects as a path outside
  the included set.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
